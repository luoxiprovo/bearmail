[Unit]
Description=Stalwart Mail and Calendar Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stalwart-webui
Group=stalwart-webui
WorkingDirectory=@@PREFIX@@
Environment=WEBUI_ROOT=@@PREFIX@@/dist
Environment=WEBUI_HOST=127.0.0.1
Environment=WEBUI_PORT=@@PORT@@
ExecStart=/usr/bin/env node @@PREFIX@@/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@PREFIX@@

[Install]
WantedBy=multi-user.target
