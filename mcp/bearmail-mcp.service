[Unit]
Description=BearMail MCP server
After=network-online.target stalwart.service
Wants=network-online.target

[Service]
Type=simple
User=stalwart-webui
Group=stalwart-webui
WorkingDirectory=@@PREFIX@@
Environment=BEARMAIL_SERVER=@@SERVER@@
Environment=BEARMAIL_MCP_HOST=127.0.0.1
Environment=BEARMAIL_MCP_PORT=@@PORT@@
Environment=BEARMAIL_MCP_PATH=/mcp
Environment=BEARMAIL_SEND_MODE=draft-only
ExecStart=@@NODE_BIN@@ @@PREFIX@@/dist/http.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@@PREFIX@@

[Install]
WantedBy=multi-user.target
