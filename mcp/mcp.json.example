# MCP stdio (Cursor / Claude Desktop / Hermes)
# Copy to the host MCP config. Use an app password as BEARMAIL_PASSWORD
# (HTTP Basic with BEARMAIL_USERNAME). BEARMAIL_TOKEN is for OAuth only.
# Never the human primary password.

{
  "mcpServers": {
    "bearmail": {
      "command": "node",
      "args": ["/opt/bearmail-mcp/dist/stdio.js"],
      "env": {
        "BEARMAIL_SERVER": "https://mail.example.com",
        "BEARMAIL_USERNAME": "scheduler@example.com",
        "BEARMAIL_PASSWORD": "<app-password>",
        "BEARMAIL_SEND_MODE": "draft-only"
      }
    }
  }
}
