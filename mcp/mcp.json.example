# MCP stdio (Cursor / Claude Desktop / Hermes)
# Copy to the host MCP config. BEARMAIL_TOKEN is a Stalwart API key (API_…),
# sent as Bearer. Optional BEARMAIL_USERNAME is the mailbox address.
# Never the human primary password or an app_… application password.

{
  "mcpServers": {
    "bearmail": {
      "command": "node",
      "args": ["/opt/bearmail-mcp/dist/stdio.js"],
      "env": {
        "BEARMAIL_SERVER": "https://mail.example.com",
        "BEARMAIL_USERNAME": "scheduler@example.com",
        "BEARMAIL_TOKEN": "API_<stalwart-api-key>",
        "BEARMAIL_SEND_MODE": "draft-only"
      }
    }
  }
}
