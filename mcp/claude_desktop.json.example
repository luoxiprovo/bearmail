# Claude Desktop — paste the JSON object into claude_desktop_config.json
# (macOS: ~/Library/Application Support/Claude/claude_desktop_config.json)
# BEARMAIL_TOKEN is a Stalwart API key (API_…), sent as Bearer.
# On a laptop, change args to your local dist/stdio.js path.

{
  "mcpServers": {
    "bearmail": {
      "command": "node",
      "args": ["/opt/bearmail-mcp/dist/stdio.js"],
      "env": {
        "BEARMAIL_SERVER": "https://mail.example.com",
        "BEARMAIL_USERNAME": "scheduler@example.com",
        "BEARMAIL_TOKEN": "API_<stalwart-api-key>",
        "BEARMAIL_SEND_MODE": "draft-only"
      }
    }
  }
}
