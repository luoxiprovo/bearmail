def secret_values(secrets: dict | None) -> list[str]:
    if not secrets:
        return []
    values = [secrets.get("smtpKey", ""), secrets.get("adminPassword", "")]
    dns = secrets.get("dns") or {}
    values.extend(str(dns.get(key) or "") for key in ("token", "username", "apiKey", "apiSecret"))
    return [value for value in values if len(value) >= 4]


def write_result(path: Path, payload: dict, secrets: list[str]) -> None:
    if path.is_symlink():
        raise InstallError("SERVICE_FAILED", "The result path must not be a symbolic link.", 1)
    text = json.dumps(payload, indent=2) + "\n"
    for secret in secrets:
        if secret and secret in text:
            raise InstallError("SERVICE_FAILED", "The result builder tried to record a credential.", 1)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(text, encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)
    os.chmod(path, 0o600)


def finish(result_path: Path | None, payload: dict, secrets: dict | None, exit_code: int) -> int:
    values = secret_values(secrets)
    if result_path is None:
        return exit_code
    try:
        write_result(result_path, payload, values)
    except InstallError as exc:
        eprint(exc.message)
        return exc.exit_code
    text = result_path.read_text(encoding="utf-8")
    for value in values:
        if value in text:
            eprint("The result file contained a credential and was removed.")
            result_path.unlink(missing_ok=True)
            return 1
    return exit_code


def redact(text: str, secrets: list[str]) -> str:
    redacted = text
    for secret in secrets:
        redacted = redacted.replace(secret, "***")
    return redacted


def write_noninteractive_answers(path: Path, config: dict, secrets: dict) -> None:
    fields = {
        "portal": config["webmailHostname"],
        "mailHostname": config["mailHostname"],
        "domain": config["domain"],
        "smtpLogin": config["relay"]["login"],
        "smtpKey": secrets["smtpKey"],
    }
    for value in fields.values():
        if not isinstance(value, str) or not value or "\n" in value or "\r" in value or "\0" in value:
            raise InstallError("INVALID_INPUT", "An installation answer contains a newline or is empty.", 2)
    if path.is_symlink() or path.parent.is_symlink() or not path.parent.is_dir():
        raise InstallError("SERVICE_FAILED", "The noninteractive answer directory is not usable.", 1)
    text = json.dumps(fields) + "\n"
    path.unlink(missing_ok=True)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    try:
        os.write(fd, text.encode("utf-8"))
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def child_environment(config: dict, secrets: dict, answer: Path) -> dict:
    blocked = [
        value for value in (secrets.get("smtpKey", ""), secrets.get("adminPassword", ""))
        if isinstance(value, str) and len(value) >= 4
    ]
    env = {}
    for key, value in os.environ.items():
        if any(secret in value for secret in blocked):
            continue
        env[key] = value
    env["BEARMAIL_EASY"] = "1"
    env["BEARMAIL_NONINTERACTIVE_FILE"] = str(answer)
    env["BEARMAIL_INSTALL_ENGINE_DKIM_FILE"] = str(state_dir(config) / "engine-dkim.json")
    env["BEARMAIL_REMINDER_FILE"] = str(state_dir(config) / ".bearmail-reminder")
    for value in env.values():
        if any(secret in value for secret in blocked):
            raise InstallError("SERVICE_FAILED", "The installer environment would contain a credential.", 1)
    return env


def run_logged(command: list[str], env: dict, cwd: Path, secrets: list[str], log_path: Path) -> int:
    if not log_path.parent.is_dir():
        raise InstallError("SERVICE_FAILED", "The install state directory is missing.", 1)
    completed = subprocess.run(
        command,
        cwd=str(cwd),
        env=env,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        check=False,
    )
    text = completed.stdout.decode("utf-8", "replace") + completed.stderr.decode("utf-8", "replace")
    log_path.write_text(redact(text, secrets), encoding="utf-8")
    os.chmod(log_path, 0o600)
    return completed.returncode


def run_existing_install(config: dict, secrets: dict, artifact_dir: Path) -> None:
    if config["webmailHostname"] in EXAMPLE_WEBMAIL and not (test_hooks() and os.environ.get("BEARMAIL_INSTALL_APPLY_SCRIPT")):
        raise InstallError(
            "INVALID_INPUT",
            "webmailHostname is an installer example. Send the customer's webmail hostname.",
            2,
        )
    answer = state_dir(config) / ANSWER_NAME
    try:
        write_noninteractive_answers(answer, config, secrets)
        env = child_environment(config, secrets, answer)
        if test_hooks() and os.environ.get("BEARMAIL_INSTALL_APPLY_SCRIPT"):
            command = ["sh", os.environ["BEARMAIL_INSTALL_APPLY_SCRIPT"]]
        else:
            if os.geteuid() != 0:
                raise InstallError("SERVICE_FAILED", "Run bearmail-install as root.", 1)
            command = ["bash", str(artifact_dir / "install.sh")]
        log_path = state_dir(config) / "bearmail-install.log"
        status = run_logged(command, env, artifact_dir, secret_values(secrets), log_path)
    finally:
        answer.unlink(missing_ok=True)
    if status != 0:
        raise InstallError("SERVICE_FAILED", "The existing BearMail installer did not finish.", 1)
    if not test_hooks():
        mcp = subprocess.run(
            ["sh", str(artifact_dir / "mcp_install.sh"), "--server-url", f"https://{config['mailHostname']}"],
            cwd=str(artifact_dir),
            check=False,
            capture_output=True,
            text=True,
        )
        if mcp.returncode != 0:
            raise InstallError("SERVICE_FAILED", "The MCP sidecar installer did not finish.", 10, True)
    align_admin_password(config, secrets)
    apply_quota(config, secrets)


def jmap_call(config: dict, username: str, password: str, method: str, arguments: dict) -> dict:
    body = json.dumps({
        "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
        "methodCalls": [[method, arguments, "call"]],
    }).encode()
    token = base64.b64encode(f"{username}:{password}".encode()).decode()
    url = os.environ.get("BEARMAIL_INSTALL_JMAP_URL") or "http://127.0.0.1:8080/jmap/"
    request = urllib.request.Request(
        url,
        data=body,
        headers={"Authorization": f"Basic {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            payload = json.loads(response.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, socket.timeout, json.JSONDecodeError) as exc:
        raise InstallError("SERVICE_FAILED", "The mail engine rejected a management call.", 1) from exc
    responses = payload.get("methodResponses") or []
    if not responses or responses[0][0] == "error":
        raise InstallError("SERVICE_FAILED", "The mail engine rejected a management call.", 1)
    return responses[0][1]


def align_admin_password(config: dict, secrets: dict) -> None:
    if test_hooks() and os.environ.get("BEARMAIL_INSTALL_SKIP_JMAP") == "1":
        reminder = state_dir(config) / ".bearmail-reminder"
        if reminder.is_file():
            reminder.unlink()
        return
    reminder = state_dir(config) / ".bearmail-reminder"
    engine_password = secrets["adminPassword"]
    if reminder.is_file():
        lines = reminder.read_text(encoding="utf-8").splitlines()
        if len(lines) >= 2 and lines[1]:
            engine_password = lines[1]
        reminder.unlink()
    username = secrets["adminUser"]
    if "@" not in username:
        username = f"{username}@{config['domain']}"
    engine_user = f"admin@{config['domain']}"
    queried = jmap_call(config, engine_user, engine_password, "x:Principal/query", {"filter": {"name": engine_user}})
    ids = queried.get("ids") or []
    if len(ids) != 1:
        raise InstallError("SERVICE_FAILED", "The engine administrator account was not found.", 1)
    principal_id = ids[0]
    current = jmap_call(config, engine_user, engine_password, "x:Principal/get", {
        "ids": [principal_id],
        "properties": ["name", "credentials"],
    })
    listed = current.get("list") or []
    credential_id = None
    if listed:
        for credential in listed[0].get("credentials") or []:
            if isinstance(credential, dict) and credential.get("@type") == "Password":
                credential_id = credential.get("credentialId")
                break
    password_credential = {"@type": "Password", "secret": secrets["adminPassword"]}
    if credential_id is not None:
        password_credential["credentialId"] = credential_id
    update = {"credentials": [password_credential]}
    if username != engine_user:
        update["name"] = username
    if engine_password == secrets["adminPassword"] and username == engine_user:
        return
    jmap_call(config, engine_user, engine_password, "x:Principal/set", {"update": {principal_id: update}})


def apply_quota(config: dict, secrets: dict) -> None:
    if test_hooks() and os.environ.get("BEARMAIL_INSTALL_SKIP_JMAP") == "1":
        return
    try:
        username = secrets["adminUser"]
        if "@" not in username:
            username = f"{username}@{config['domain']}"
        queried = jmap_call(config, username, secrets["adminPassword"], "x:Principal/query", {"filter": {"name": username}})
        ids = queried.get("ids") or []
        if len(ids) != 1:
            return
        jmap_call(config, username, secrets["adminPassword"], "x:Principal/set", {
            "update": {ids[0]: {"quotas": {"maxDiskQuota": config["mailboxQuotaBytes"]}}},
        })
    except InstallError:
        return


def service_checks() -> dict:
    if test_hooks():
        return {"engine": "running", "webui": "running", "https": "running", "mcp": "loopback"}

    def active(unit: str) -> str:
        completed = subprocess.run(["systemctl", "is-active", unit], check=False, capture_output=True, text=True)
        return "running" if completed.stdout.strip() == "active" else "stopped"

    return {
        "engine": active("stalwart.service"),
        "webui": active("bearmail-webui.service"),
        "https": active("caddy.service"),
        "mcp": "loopback" if active("bearmail-mcp.service") == "running" else "stopped",
    }


def certificate_not_after(hostname: str) -> str | None:
    root = Path("/var/lib/caddy/.local/share/caddy/certificates")
    if not root.is_dir():
        return None
    matches = list(root.glob(f"**/{hostname}/{hostname}.crt"))
    if not matches:
        matches = list(root.glob(f"**/{hostname}.crt"))
    if not matches:
        return None
    try:
        completed = subprocess.run(
            ["openssl", "x509", "-in", str(matches[0]), "-noout", "-enddate"],
            check=False,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = re.search(r"notAfter=(.+)", completed.stdout)
    if not match or completed.returncode != 0:
        return None
    try:
        parsed = time.strptime(match.group(1).strip(), "%b %d %H:%M:%S %Y %Z")
    except ValueError:
        return None
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", parsed)


def tls_status(config: dict) -> dict:
    if test_hooks():
        pending = os.environ.get("BEARMAIL_INSTALL_TLS") == "pending"
        item = {"status": "pending" if pending else "issued", "notAfter": None if pending else "2027-01-30T00:00:00Z"}
        return {"mail": dict(item), "webmail": dict(item)}
    result = {}
    for key, host in (("mail", config["mailHostname"]), ("webmail", config["webmailHostname"])):
        not_after = certificate_not_after(host)
        if not_after:
            result[key] = {"status": "issued", "notAfter": not_after}
        else:
            result[key] = {"status": "pending", "notAfter": None}
    return result


def checkpoint(config: dict, plan: dict, status: str, versions: dict, checks: dict | None, tls: dict | None) -> None:
    payload = blank_result(config, status, None, plan, versions)
    if checks:
        payload["serviceChecks"] = checks
    if tls:
        payload["tls"] = tls
    save_state(config, {
        "operationId": config["operationId"],
        "identity": identity_of(config),
        "status": status,
        "mxPublished": any(item["type"] == "MX" and item["state"] == "published" for item in plan.get("published", [])),
        "engineDkim": {
            "host": plan.get("engineDkimHost"),
            "value": plan.get("engineDkimValue"),
        },
        "result": payload,
    })


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="bearmail-install", add_help=True)
    parser.add_argument("--input", required=True)
    parser.add_argument("--result", required=True)
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    result_path = None
    secrets = None
    config = None
    try:
        try:
            args = parse_args(argv)
        except SystemExit as exc:
            if exc.code not in (0, None):
                eprint("Usage: bearmail-install --input <input.json> --result <result.json> [--dry-run]")
                return 2
            return 0
        result_path = Path(args.result)
        config = validate_input(read_json_file(Path(args.input), "input"))
        if not args.dry_run and not config["mxCutoverAuthorized"]:
            raise InstallError("MX_NOT_AUTHORIZED", "MX replacement was not authorized.", 1)
        secrets = load_secrets(config)
        artifact_dir = verify_artifacts(config)
        state = load_state(config)
        if state and state.get("operationId") == config["operationId"] and state.get("identity") != identity_of(config):
            raise InstallError("IDEMPOTENCY_CONFLICT", "This operationId was already used for a different configuration.", 1)
        if state and state.get("operationId") == config["operationId"] and state.get("status") == "succeeded" and not args.dry_run:
            payload = state.get("result") or blank_result(config, "succeeded", None, None, versions_from(artifact_dir))
            payload["generation"] = config["generation"]
            payload["retryable"] = False
            return finish(result_path, payload, secrets, 0)
        check_data_path(config, state, create=not args.dry_run)
        if not args.dry_run:
            published_mx = bool(state and state.get("mxPublished"))
            try:
                check_relay(config, secrets["smtpKey"])
            except InstallError as exc:
                if exc.code == "RELAY_AUTH_FAILED" and published_mx:
                    raise InstallError("RELAY_AUTH_FAILED", "The Brevo SMTP login was rejected.", 1) from exc
                raise
        existing = read_zone(config, secrets)
        engine_dkim = load_engine_dkim(config, state, existing)
        plan = build_plan(config, existing, engine_dkim if args.dry_run else None)
        versions = versions_from(artifact_dir)
        if args.dry_run:
            return finish(result_path, blank_result(config, "dry_run", None, plan, versions), secrets, 0)
        run_existing_install(config, secrets, artifact_dir)
        existing = read_zone(config, secrets)
        engine_dkim = load_engine_dkim(config, state, existing)
        if not engine_dkim:
            raise InstallError("SERVICE_FAILED", "The mail engine did not produce a DKIM key.", 1)
        plan = build_plan(config, existing, engine_dkim)
        plan = publish_zone(config, secrets, existing, plan)
        checks = service_checks()
        if any(value == "stopped" for value in checks.values()):
            raise InstallError("SERVICE_FAILED", "A required service is not running.", 1)
        tls = tls_status(config)
        pending = tls["mail"]["status"] != "issued" or tls["webmail"]["status"] != "issued"
        status = "tls_pending" if pending else "succeeded"
        error = InstallError("TLS_PENDING", "Certificate issuance is waiting on DNS propagation.", 10, True) if pending else None
        payload = blank_result(config, status, error, plan, versions)
        payload["serviceChecks"] = checks
        payload["tls"] = tls
        payload["retryable"] = pending
        checkpoint(config, plan, status, versions, checks, tls)
        return finish(result_path, payload, secrets, 10 if pending else 0)
    except InstallError as exc:
        if result_path is None:
            eprint(exc.message)
            return exc.exit_code
        status = "failed"
        if exc.code == "TLS_PENDING":
            status = "tls_pending"
        elif exc.code == "DNS_PUBLISH_FAILED" and exc.retryable and exc.plan:
            status = "dns_partial"
        elif exc.code == "DNS_RATE_LIMITED":
            status = "dns_partial"
        payload = blank_result(config, status, exc, exc.plan, None)
        payload["retryable"] = exc.retryable
        if exc.plan and config is not None and exc.retryable:
            versions = payload["installedVersions"]
            checkpoint(config, exc.plan, status, versions, None, None)
        return finish(result_path, payload, secrets, exc.exit_code)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
